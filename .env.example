# Settings for every workflow. Copy to .env and fill in; jobhunting_core loads .env on import (this file
# when there is no .env). A variable already set in the environment wins.

# Model per agent stage (a Paseo provider).
JOBHUNTING_SCREEN_MODEL=claude/claude-sonnet-5-5
JOBHUNTING_TAILOR_MODEL=claude/claude-sonnet-5-5
JOBHUNTING_FILL_MODEL=claude/claude-sonnet-5-5

# Private identity files and Tailor's output; both outside Git tracking.
JOBHUNTING_PRIVATE_DIR=tmp/private
JOBHUNTING_TAILOR_OUTPUT=tmp/tailor-output

# The fixed master CV PDF and the agent's Google OAuth client ID.
JOBHUNTING_MASTER_CV=tmp/master-cv.pdf
JOBHUNTING_GOOGLE_CLIENT_ID=

# Tailor: the career repository with the applicant's facts (a sibling of this repository by default), the applicant's name and website,
# and optional comma-separated markers of experiences that must survive tailoring.
JOBHUNTING_CAREER_DIR=../career
JOBHUNTING_APPLICANT_NAME=
JOBHUNTING_WEBSITE=
JOBHUNTING_STRONG_EVIDENCE=
